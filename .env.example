# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dashcamiq

# ─── Redis / Celery ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Cloudflare R2 ───────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev
R2_MAIN_FOLDER=your_main_folder_name
R2_FRONT_FOLDER=front
R2_REAR_FOLDER=rear

# ─── Claude API ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── App ─────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000

# ─── ML ──────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/yolov8m.pt
FEATURE_DIM=128
LSTM_HIDDEN_SIZE=256
LSTM_NUM_LAYERS=2
